{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/password.php", "dest": "/api/password.php" },
    { "src": "/submit.php", "dest": "/api/submit.php" },
    { "src": "/verified.php", "dest": "/api/verified.php" },
    { "src": "/panel.php", "dest": "/api/panel.php" },
    { "src": "/clear.php", "dest": "/api/clear.php" }
  ]
}
